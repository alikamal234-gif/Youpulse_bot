# ==============================================================================
# Configuration du Bot Discord - YouPulse
# ==============================================================================
# IMPORTANT : Ne committez JAMAIS ce fichier avec de vrais secrets.
# Copiez ce fichier vers .env et renseignez vos véritables identifiants.
# ==============================================================================

# Jeton d'authentification du bot (obtenu sur le Discord Developer Portal)
# https://discord.com/developers/applications -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=votre_token_secret_ici

# Identifiant client de l'application Discord (Application ID)
# https://discord.com/developers/applications -> Your App -> General Information -> Application ID
DISCORD_CLIENT_ID=123456789012345678

# Identifiant Discord du propriétaire autorisé (User ID du propriétaire)
# Clic droit sur votre profil Discord en Mode Développeur -> Copier l'identifiant
DISCORD_OWNER_ID=123456789012345678

# Identifiant du salon Discord par défaut pour le relais et les notifications
# (Optionnel : peut aussi être configuré dynamiquement via la commande /setchannel)
DISCORD_CHANNEL_ID=123456789012345678

# Identifiant du serveur pour enregistrer les commandes instantanément en développement
# (Optionnel : laisser vide pour un déploiement global de commandes)
DISCORD_GUILD_ID=

# Port pour le serveur HTTP de vérification de santé (Health-check pour Koyeb/Render)
# (Optionnel : par défaut 3000 si spécifié)
PORT=3000

# Niveau de journalisation (info, debug, warn, error)
LOG_LEVEL=info
